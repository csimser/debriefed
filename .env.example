# Debriefed is a zero-backend app — there are no server secrets.
#
# The Anthropic API key is NOT configured here. Users bring their own key,
# entered once in the app's Settings and stored in the browser's localStorage.
#
# These optional variables only affect local development / builds:

# Base URL used in sitemap + metadata generation (defaults to production)
NEXT_PUBLIC_APP_URL=https://getdebriefed.co

# Support email shown in the UI
NEXT_PUBLIC_SUPPORT_EMAIL=chris@getdebriefed.co
